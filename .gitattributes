# Normalize line endings: store LF in the repo, check out per platform
* text=auto eol=lf

# Docs
*.md        text diff=markdown
*.txt       text

# Binary assets (no diff, no line-ending conversion)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
